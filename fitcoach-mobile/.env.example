# FitCoach mobile -> backend connection.
#
# Copy to `.env` and point these at a running fitcoach-backend:
#
#   cd ../fitcoach-backend && mvn spring-boot:run      # terminal 1
#   cp .env.example .env && npm start                  # terminal 2
#
# EXPO_PUBLIC_* variables are inlined by Metro at build time, so a change here
# needs a bundler restart (npm start -- --clear) to take effect.
#
# There is no offline/mock fallback. If these are wrong or the backend is down,
# the app shows a network error — that is intentional, so a misconfiguration can
# never look like "working" with silently stale data.

# Base URL of the Spring Boot service (no trailing slash).
# Physical device / emulator: use your machine's LAN IP, not localhost.
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# STOMP endpoint for chat + cache invalidation (config/WebSocketConfig).
# Defaults to EXPO_PUBLIC_API_URL with ws(s) + /ws when omitted.
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws
